{
  "name": "shopright-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Hyperlocal marketplace app (Customer, Merchant, Delivery Partner, Admin) with unified backend",
  "workspaces": [
    "packages/*",
    "apps/*",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "npm run dev --workspace=server",
    "dev:customer": "npm run dev --workspace=apps/customer-web",
    "dev:merchant": "npm run dev --workspace=apps/merchant-web",
    "dev:delivery": "npm run dev --workspace=apps/delivery-web",
    "dev:admin": "npm run dev --workspace=apps/admin-web",
    "prisma:generate": "npm run prisma:generate --workspace=server",
    "prisma:migrate": "npm run prisma:migrate --workspace=server",
    "prisma:studio": "npm run prisma:studio --workspace=server",
    "seed:data": "npm run seed:data --workspace=server",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "keywords": [
    "hyperlocal",
    "marketplace",
    "monorepo",
    "express",
    "prisma",
    "react",
    "vite"
  ],
  "author": "ShopRight Team",
  "license": "ISC"
}
