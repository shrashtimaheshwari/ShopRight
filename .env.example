# Server Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
# Use localhost for local dev; in Docker network use db hostname
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopright?schema=public

# Authentication & JWT (Security Doc §2 & §11)
# Access token: short-lived (e.g. 15m), Refresh token: longer-lived (e.g. 7d)
JWT_ACCESS_SECRET=dev_jwt_access_secret_do_not_use_in_prod_12345
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_do_not_use_in_prod_67890
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# Cloudinary (Media storage - sandbox/dev placeholder)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=placeholder
CLOUDINARY_API_SECRET=placeholder

# Payment Gateway (ADR-008 - Sandbox/Test mode only)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# Google OAuth (Sign in with Google)
GOOGLE_CLIENT_ID=582096119859-2frlksmhqmtaoris57b8c43br29hembu.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=582096119859-2frlksmhqmtaoris57b8c43br29hembu.apps.googleusercontent.com
